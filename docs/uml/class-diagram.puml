@startuml
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "domain（领域层，不依赖 Flask/SQLite）" {
  enum Role {
    student
    admin
  }
  enum RegistrationStatus {
    PENDING 待审核
    APPROVED 已通过
    REJECTED 已拒绝
    CANCELLED 已取消
  }
  enum PolicyType {
    DIRECT 直接报名
    APPROVAL 管理员审核
  }

  class Student {
    - student_id : String
    - name : String
    - role : Role
    + is_admin() : bool
  }

  class Activity {
    - activity_id : int
    - title : String
    - category : String
    - start_at : String
    - location : String
    - capacity : int
    - policy_type : PolicyType
    + start_time() : DateTime
  }

  class Registration {
    - registration_id : int
    - activity_id : int
    - student_id : String
    - status : RegistrationStatus
    - created_at : String
    - updated_at : String
  }

  class Message {
    - message_id : int
    - student_id : String
    - activity_id : int
    - content : String
    - created_at : String
    - is_read : bool
  }

  class ActivityStats {
    - capacity : int
    - approved_count : int
    - pending_count : int
    + remaining() : int
  }
}

package "policies（策略模式）" {
  abstract class RegistrationPolicy {
    + policy_type : PolicyType
    + requires_immediate_capacity_check : bool
    + decide(ctx : RegistrationContext) : RegistrationDecision
  }
  class DirectRegistrationPolicy
  class ApprovalRegistrationPolicy
  class PolicyRegistry {
    - _policies : Map
    + register(policy)
    + get(policy_type) : RegistrationPolicy
  }
  class RegistrationContext {
    + activity : Activity
    + student : Student
    + approved_count : int
    + is_full() : bool
  }
  class RegistrationDecision {
    + status : RegistrationStatus
    + student_message : String
  }
}

package "events + observers（观察者模式）" {
  enum RegistrationEventType {
    SUBMITTED
    APPROVED
    REJECTED
    CANCELLED
  }
  class RegistrationEvent {
    + event_type : RegistrationEventType
    + registration_id : int
    + student_id : String
    + notification_text : String
    + dedupe_key() : String
  }
  class EventBus {
    - _handlers : List
    + subscribe(handler)
    + publish(event)
  }
  class NotificationObserver {
    + handle(event)
    - _record_failure(event, exc)
  }
}

package "services（业务服务）" {
  class RegistrationService {
    + register(activity_id, student_id) : Registration
    + cancel(registration_id, student_id) : Registration
    + approve(registration_id, operator_id) : Registration
    + reject(registration_id, operator_id, reason) : Registration
    - _publish(...)
  }
  class ActivityService {
    + create(...) : Activity
    + update(...) : Activity
    + delete(operator_id, activity_id)
  }
}

package "repositories（仓储）" {
  class Database {
    + transaction()
    + connection()
  }
  class StudentRepository
  class ActivityRepository
  class RegistrationRepository {
    + find_active(activity_id, student_id)
    + count_by_status(activity_id, status)
  }
  class MessageRepository {
    + add(..., dedupe_key) : bool
  }
  class FailureRepository
  note bottom of FailureRepository
    通知失败留痕表 notification_failures
  end note
}

Student "1" -- "0..*" Registration : 报名
Activity "1" -- "0..*" Registration : 被报名
Activity "1" -- "1" ActivityStats : 统计
Student "1" -- "0..*" Message : 接收

RegistrationPolicy <|-- DirectRegistrationPolicy
RegistrationPolicy <|-- ApprovalRegistrationPolicy
PolicyRegistry o-- RegistrationPolicy : 持有
RegistrationPolicy ..> RegistrationDecision : 产出
RegistrationContext ..> Activity
RegistrationContext ..> Student
RegistrationDecision ..> RegistrationStatus

RegistrationService --> PolicyRegistry : 取策略
RegistrationService --> EventBus : 发布事件
RegistrationService --> Database : 事务
RegistrationService ..> RegistrationRepository
RegistrationService ..> ActivityRepository
RegistrationService --> RegistrationPolicy : 依赖抽象

EventBus o-- NotificationObserver : 订阅
NotificationObserver --> MessageRepository
NotificationObserver --> FailureRepository

RegistrationEvent --> RegistrationEventType
EventBus ..> RegistrationEvent

RegistrationRepository ..> Registration
ActivityService --> ActivityRepository
ActivityService --> Database
@enduml
